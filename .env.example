# ==============================================================================
# YouTube Shorts Automator - Configuration Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!
# ==============================================================================

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Primary Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Backup Gemini Key (automatically used for retries if primary is busy)
BACKUP_GEMINI_API_KEY=your_backup_gemini_key_here

# Gemini Model
GEMINI_MODEL=gemini-2.5-flash

# Groq API Keys (High-speed failover when Gemini hits rate limit)
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=your_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_here

# Groq Model (Recommended: openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Local Whisper Audio Transcription Settings
# Use "cpu" on Windows machines to avoid CUDA DLL missing errors
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_MODEL=medium

# Local Output Directory for generated clips
LOCAL_OUTPUT_DIR=output
